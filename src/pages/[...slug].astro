---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPublishedPages, routeSlug } from '../lib/pages';

export async function getStaticPaths() {
  const pages = await getPublishedPages();
  return pages.flatMap((page) => {
    const slug = routeSlug(page.id);
    if (!slug) return [];
    return [{ params: { slug }, props: { id: page.id } }];
  });
}

interface Props {
  id: string;
}

const { id } = Astro.props;
const pages = await getPublishedPages();
const page = pages.find((entry) => entry.id === id);
if (!page) {
  throw new Error(`No published page for ${id}`);
}
const { Content } = await render(page);
---

<Base title={page.data.title} currentId={page.id} pages={pages}>
  <Content />
</Base>
