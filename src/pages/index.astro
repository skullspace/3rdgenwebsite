---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPublishedPages } from '../lib/pages';

const pages = await getPublishedPages();
const home = pages.find((page) => page.id === '_index');
if (!home) {
  throw new Error('Add content/_index.md for the home page.');
}
const { Content } = await render(home);
---

<Base title={home.data.title} currentId={home.id} pages={pages}>
  <Content />
</Base>
