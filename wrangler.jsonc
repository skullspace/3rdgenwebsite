{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "winnipegisp",
  "compatibility_date": "2026-09-03",

  // Assets-only Worker: there is no `main`, because the whole site is static
  // HTML produced by `npm run build`. `binding` is deliberately omitted too —
  // it is only valid alongside a Worker script.
  //
  // `wrangler deploy` runs this command before it checks that the assets
  // directory exists. Astro writes the site to ./dist. Workers Builds does
  // not run this command as its own build step; Wrangler still does on deploy.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    // Astro emits directory-style routes (/hackerspace/index.html), and serves
    // an Astro-built 404.html for anything unmatched.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "send_metrics": false
}
